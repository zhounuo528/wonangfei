.picker-value {
    color: #2b3038;
}

.chip-row {
    display: flex;
    flex-wrap: wrap;
}

.chip {
    margin: 0 16rpx 16rpx 0;
    padding: 12rpx 24rpx;
    border: 1rpx solid #dfe3e8;
    border-radius: 999rpx;
    color: #5c636e;
    font-size: 24rpx;
}

.chip-round {
    width: 72rpx;
    padding: 12rpx 0;
    text-align: center;
}

.chip-active {
    border-color: #0f9d76;
    background: #e8f7f2;
    color: #0f9d76;
}

.switch-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22rpx 0;
    border-bottom: 1rpx solid #f3f5f7;
}

.switch-row:last-child {
    border-bottom: none;
}

.switch-copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-right: 24rpx;
}

.switch-label {
    font-size: 28rpx;
}

.switch-hint {
    margin-top: 6rpx;
    font-size: 24rpx;
    line-height: 1.5;
}

.message {
    display: block;
    margin-top: 16rpx;
    color: #0f9d76;
    font-size: 24rpx;
}

.foot-note {
    display: block;
    margin-top: 20rpx;
    font-size: 24rpx;
    line-height: 1.6;
}

.hint-line {
    display: block;
    margin-top: 12rpx;
    font-size: 24rpx;
    line-height: 1.6;
}

.timeline-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-right: 20rpx;
}

.timeline-date {
    font-size: 26rpx;
    font-weight: 600;
}

.timeline-change {
    margin-top: 4rpx;
    font-size: 26rpx;
}

.timeline-note {
    margin-top: 2rpx;
    font-size: 22rpx;
}

.undo-link {
    color: #d4380d;
    font-size: 24rpx;
}

.note {
    font-size: 24rpx;
    line-height: 1.7;
}
