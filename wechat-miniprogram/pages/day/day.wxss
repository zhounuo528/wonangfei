.day-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 8rpx 4rpx 24rpx;
}

.day-title {
    display: block;
    margin-top: 6rpx;
    font-size: 40rpx;
    font-weight: 600;
}

.hint {
    display: block;
    margin-top: 8rpx;
    font-size: 24rpx;
    line-height: 1.6;
}

.switch-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 20rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid #f3f5f7;
}

.switch-copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-right: 24rpx;
}

.switch-label {
    font-size: 28rpx;
}

.switch-hint {
    margin-top: 6rpx;
    font-size: 24rpx;
    line-height: 1.5;
}

.fixed-row {
    margin-top: 8rpx;
}

.expense-row {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
}

.expense-name {
    box-sizing: border-box;
    flex: 1 1 auto;
    min-width: 0;
    height: 76rpx;
    padding: 0 20rpx;
    border: 1rpx solid #dfe3e8;
    border-radius: 12rpx;
    background: #fbfcfd;
    font-size: 26rpx;
    line-height: 76rpx;
}

.expense-amount {
    box-sizing: border-box;
    flex: 0 0 170rpx;
    width: 170rpx;
    height: 76rpx;
    margin-left: 12rpx;
    padding: 0 16rpx;
    border: 1rpx solid #dfe3e8;
    border-radius: 12rpx;
    background: #fbfcfd;
    font-size: 26rpx;
    line-height: 76rpx;
    text-align: right;
}

.expense-remove {
    flex: 0 0 auto;
    margin-left: 16rpx;
    padding: 22rpx 0 22rpx 8rpx;
    color: #d4380d;
    font-size: 26rpx;
}

.add-row {
    width: 100%;
    height: 76rpx;
    margin-top: 8rpx;
    border: 1rpx dashed #cfd6dd;
    border-radius: 14rpx;
    background: transparent;
    color: #0f9d76;
    font-size: 26rpx;
    line-height: 74rpx;
}

.add-row::after {
    border: none;
}

.empty-row {
    display: block;
    padding: 12rpx 0 20rpx;
    font-size: 24rpx;
}

.month-block {
    margin-top: 12rpx;
    padding-top: 16rpx;
    border-top: 1rpx solid #f3f5f7;
}

.month-title {
    display: block;
    margin-bottom: 8rpx;
    font-size: 24rpx;
}

.session-row {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
}

.daily-row {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
}

.daily-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-right: 20rpx;
}

.daily-sub {
    margin-top: 4rpx;
    font-size: 22rpx;
}

.daily-amount {
    box-sizing: border-box;
    flex: 0 0 170rpx;
    width: 170rpx;
    height: 76rpx;
    padding: 0 16rpx;
    border: 1rpx solid #dfe3e8;
    border-radius: 12rpx;
    background: #fbfcfd;
    font-size: 26rpx;
    line-height: 76rpx;
    text-align: right;
}

.session-index {
    width: 120rpx;
    color: #8b9099;
    font-size: 24rpx;
}

.time-chip {
    min-width: 120rpx;
    padding: 10rpx 18rpx;
    border: 1rpx solid #dfe3e8;
    border-radius: 12rpx;
    background: #fbfcfd;
    color: #2b3038;
    font-size: 28rpx;
    text-align: center;
}

.time-plain {
    font-size: 28rpx;
}

.session-dash {
    margin: 0 12rpx;
    color: #9aa1ab;
}

.session-tag {
    margin-left: 12rpx;
    font-size: 20rpx;
}

.add-session {
    display: flex;
    align-items: center;
    margin-top: 8rpx;
    padding-top: 16rpx;
    border-top: 1rpx solid #f3f5f7;
}

.add-label {
    width: 140rpx;
    font-size: 24rpx;
}

.sheet-note {
    display: block;
    margin-top: 10rpx;
}

.item-title {
    font-size: 26rpx;
}

.item-amount {
    font-size: 26rpx;
    font-weight: 600;
}

.fixed-total {
    margin-top: 12rpx;
}

.confirm-row {
    display: flex;
    align-items: center;
    margin-top: 20rpx;
}

.checkbox {
    width: 40rpx;
    height: 40rpx;
    margin-right: 16rpx;
    border: 2rpx solid #cfd4da;
    border-radius: 10rpx;
    color: #ffffff;
    font-size: 26rpx;
    line-height: 36rpx;
    text-align: center;
}

.checkbox-on {
    border-color: #0f9d76;
    background: #0f9d76;
}

.confirm-text {
    font-size: 26rpx;
}

.secondary-actions {
    display: flex;
    margin-top: 16rpx;
}

.action {
    flex: 1;
    margin-top: 0;
    font-size: 26rpx;
}

.action + .action {
    margin-left: 16rpx;
}

.foot-note {
    display: block;
    margin-top: 24rpx;
    font-size: 24rpx;
    line-height: 1.7;
}
