.tabs {
    display: flex;
    margin-bottom: 24rpx;
    padding: 6rpx;
    border-radius: 16rpx;
    background: #eef1f4;
}

.tab {
    flex: 1;
    padding: 16rpx 0;
    border-radius: 12rpx;
    color: #5c636e;
    font-size: 26rpx;
    text-align: center;
}

.tab-active {
    background: #ffffff;
    color: #0f9d76;
    font-weight: 600;
}

.item-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-right: 20rpx;
}

.item-title {
    font-size: 28rpx;
}

.voided {
    color: #a8adb5;
    text-decoration: line-through;
}

.item-sub {
    margin-top: 4rpx;
    font-size: 22rpx;
}

.item-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.item-amount {
    font-size: 28rpx;
    font-weight: 600;
}

.stop-link {
    margin-top: 6rpx;
    color: #d4380d;
    font-size: 22rpx;
}

.foot-note {
    display: block;
    margin-top: 16rpx;
    padding-top: 16rpx;
    border-top: 1rpx solid #f3f5f7;
    font-size: 22rpx;
    line-height: 1.6;
}

.picker-value {
    color: #2b3038;
}
