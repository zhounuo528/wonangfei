.tabs {
    display: flex;
    margin-bottom: 20rpx;
    padding: 6rpx;
    border-radius: 16rpx;
    background: #eef1f4;
}

.tab {
    flex: 1;
    padding: 16rpx 0;
    border-radius: 12rpx;
    color: #5c636e;
    font-size: 26rpx;
    text-align: center;
}

.tab-active {
    background: #ffffff;
    color: #0f9d76;
    font-weight: 600;
}

.period-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24rpx;
    padding: 0 8rpx;
}

.period-nav {
    width: 64rpx;
    height: 64rpx;
    border-radius: 50%;
    background: #ffffff;
    color: #3c424b;
    font-size: 36rpx;
    line-height: 60rpx;
    text-align: center;
}

.period-label {
    font-size: 30rpx;
    font-weight: 600;
}

.big-amount {
    display: block;
    margin: 12rpx 0 8rpx;
    font-size: 60rpx;
    font-weight: 600;
}

.row-value {
    display: block;
    margin-top: 4rpx;
    font-size: 30rpx;
    font-weight: 600;
}

.grid2 {
    display: flex;
    flex-wrap: wrap;
}

.cell2 {
    box-sizing: border-box;
    width: 50%;
    padding: 12rpx 0;
}

.align-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.foot-note {
    display: block;
    margin-top: 12rpx;
    font-size: 24rpx;
    line-height: 1.6;
}

.empty {
    color: #8b9099;
    text-align: center;
}
