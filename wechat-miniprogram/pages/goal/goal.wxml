<view class="page">
    <view class="card">
        <view class="card-head">
            <text class="card-title">{{name}}</text>
            <text class="pill {{statusTone}}">{{statusText}}</text>
        </view>
        <view class="progress-track">
            <view class="progress-fill" style="width: {{percent}}%"></view>
        </view>
        <view class="row-between goal-meta">
            <text class="muted">已攒 {{poolText}}</text>
            <text class="muted">目标 {{amountText}}</text>
        </view>
        <view class="row-between goal-meta">
            <text class="muted">还差</text>
            <text class="strong">{{remainingText}}</text>
        </view>
        <button class="primary" wx:if="{{percent >= 100}}" bindtap="settle">结算这个目标</button>
    </view>

    <view class="card">
        <view class="card-head">
            <text class="card-title">设置目标</text>
        </view>
        <view class="field">
            <text class="field-label">目标名称</text>
            <input class="field-input" maxlength="40" placeholder="例如 换一副耳机" value="{{formName}}" bindinput="handleName" />
        </view>
        <view class="field">
            <text class="field-label">目标金额（元）</text>
            <input class="field-input" type="digit" placeholder="例如 1500.00" value="{{formAmount}}" bindinput="handleAmount" />
        </view>
        <text class="error-text" wx:if="{{error !== ''}}">{{error}}</text>
        <button class="primary" bindtap="save">保存目标</button>
        <text class="muted foot-note">工资减去开销后的钱，就是为目标攒下的净赚。目标不限时；完成后扣掉目标金额，剩余留给下个目标。</text>
    </view>

    <view class="card" wx:if="{{settlements.length > 0}}">
        <view class="card-head">
            <text class="card-title">完成记录</text>
        </view>
        <view class="list-item" wx:for="{{settlements}}" wx:key="id">
            <view>
                <text class="item-title">{{item.name}}</text>
                <text class="muted item-sub">{{item.dateText}}</text>
            </view>
            <text class="strong">{{item.amountText}}</text>
        </view>
    </view>
</view>
